# Configuration du backend. Copier en back/.env (jamais commité).

# MySQL (Optiplex en prod)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=apisketch
DB_USERNAME=apisketch
DB_PASSWORD=
# Surcharge complète possible (ex. tests) : DATABASE_URL=sqlite:///./dev.db
DATABASE_URL=

# Port d'écoute uvicorn (derrière nginx en prod)
SERVER_PORT=8090

# Secret de signature des jetons. Générer : python -c "import secrets;print(secrets.token_hex(32))"
JWT_SECRET=CHANGE_ME
# Durée de vie d'un jeton de connexion (jours)
JWT_TTL_DAYS=30
# Durée de validité par défaut d'une invitation (jours)
INVITE_TTL_DAYS=14

# Origines autorisées (CSV) : le front est sur un autre domaine que l'API
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://api-sketch.pi-cto.top

# Dossier où yt-dlp stockera les sketchs (étape suivante)
MEDIA_DIR=./media
