# Front (SPA statique). Les lignes "managed by Certbot" seront ajoutées par
# `sudo certbot --nginx -d api-sketch.pi-cto.top` lors de la première install,
# puis à reporter ici pour que deploy.sh ne les écrase pas.
server {
    listen 80;
    listen [::]:80;
    server_name api-sketch.pi-cto.top;

    root /var/www/apisketch;
    index index.html;

    gzip on;
    gzip_vary on;
    gzip_comp_level 6;
    gzip_min_length 256;
    gzip_types text/plain text/css application/json application/javascript image/svg+xml;

    # Fichiers hashés par Vite : cache long terme sans risque.
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    location = /index.html {
        add_header Cache-Control "no-cache";
    }

    location / {
        try_files $uri $uri/ /index.html;   # routing SPA
    }
}
