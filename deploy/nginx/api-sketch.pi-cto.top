# Front (SPA statique). Les lignes "managed by Certbot" viennent de
# `sudo certbot --nginx -d api-sketch.pi-cto.top -d api-sketch-back.pi-cto.top`
# et sont reportées ici pour que deploy.sh ne les écrase pas.
server {
    server_name api-sketch.pi-cto.top;

    root /var/www/apisketch;
    index index.html;

    gzip on;
    gzip_vary on;
    gzip_comp_level 6;
    gzip_min_length 256;
    gzip_types text/plain text/css application/json application/javascript image/svg+xml;

    # Fichiers hashés par Vite : cache long terme sans risque.
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    location = /index.html {
        add_header Cache-Control "no-cache";
    }

    location / {
        try_files $uri $uri/ /index.html;   # routing SPA
    }

    listen [::]:443 ssl; # managed by Certbot
    listen 443 ssl; # managed by Certbot
    ssl_certificate /etc/letsencrypt/live/api-sketch.pi-cto.top/fullchain.pem; # managed by Certbot
    ssl_certificate_key /etc/letsencrypt/live/api-sketch.pi-cto.top/privkey.pem; # managed by Certbot
    include /etc/letsencrypt/options-ssl-nginx.conf; # managed by Certbot
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem; # managed by Certbot

}

server {
    if ($host = api-sketch.pi-cto.top) {
        return 301 https://$host$request_uri;
    } # managed by Certbot


    listen 80;
    listen [::]:80;
    server_name api-sketch.pi-cto.top;
    return 404; # managed by Certbot


}
